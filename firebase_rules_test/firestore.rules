rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
      Proposta segura mesclada.
      ATENCAO: este arquivo nao contem o export real das rules de producao.
      Ele foi montado para servir de base de mesclagem manual com as regras
      atuais do Firebase Console.

      Nao conectar ao firebase.json nem fazer deploy direto.
    */

    function isSignedIn() {
      return request.auth != null;
    }

    function usuarioDoc(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function usuarioCamposSensiveis() {
      return [
        "tipo",
        "peso_permissao",
        "role",
        "papel",
        "admin",
        "administrador",
        "isAdmin",
        "permissoes",
        "permissions",
        "uid",
        "email",
        "criadoEm",
        "criadoPor",
        "nivel",
        "nivel_acesso",
        "accessLevel",
        "status_conta",
        "statusConta",
        "ativo",
        "super_admin",
        "superadmin"
      ];
    }

    function selfUsuarioUpdateSeguro(userId) {
      return isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(usuarioCamposSensiveis());
    }

    function permissoesUsuarioDoc(uid) {
      return /databases/$(database)/documents/usuarios/$(uid)/permissoes_usuario/configuracoes;
    }

    function alunoDoc(alunoId) {
      return /databases/$(database)/documents/alunos/$(alunoId);
    }

    function usuarioContaLiberada(uid) {
      return exists(usuarioDoc(uid))
        && !(
          ("status_conta" in get(usuarioDoc(uid)).data)
          && get(usuarioDoc(uid)).data.status_conta in [
            "bloqueada",
            "bloqueado",
            "inativa",
            "inativo",
            "rejeitada",
            "rejeitado"
          ]
        );
    }

    function isAdmin() {
      return isSignedIn()
        && usuarioContaLiberada(request.auth.uid)
        && exists(usuarioDoc(request.auth.uid))
        && (
          (("peso_permissao" in get(usuarioDoc(request.auth.uid)).data)
            && get(usuarioDoc(request.auth.uid)).data.peso_permissao >= 90)
          || get(usuarioDoc(request.auth.uid)).data.tipo == "admin"
          || get(usuarioDoc(request.auth.uid)).data.tipo == "administrador"
        );
    }

    function podeGerenciarEstudosFundamentos() {
      return isAdmin()
        || (
          isSignedIn()
          && usuarioContaLiberada(request.auth.uid)
          && exists(permissoesUsuarioDoc(request.auth.uid))
          && get(permissoesUsuarioDoc(request.auth.uid)).data.pode_gerenciar_estudos_fundamentos == true
        );
    }

    function canManageControleAtualizacoes() {
      return isAdmin()
        || (
          isSignedIn()
          && usuarioContaLiberada(request.auth.uid)
          && exists(permissoesUsuarioDoc(request.auth.uid))
          && get(permissoesUsuarioDoc(request.auth.uid)).data.pode_controle_atualizacoes == true
        );
    }

    function alunoPertenceAoUsuario(alunoId) {
      return isSignedIn()
        && exists(alunoDoc(alunoId))
        && get(alunoDoc(alunoId)).data.areaAlunoGoogleVinculado == true
        && get(alunoDoc(alunoId)).data.areaAlunoGoogleUid == request.auth.uid;
    }

    function estudosConfig() {
      return get(/databases/$(database)/documents/estudos_config/global).data;
    }

    function statusPublicadoOuEmBrevePermitido(data) {
      return data.status == "publicado"
        || (data.status == "em_breve" && estudosConfig().mostrarEmBreve == true);
    }

    function conteudoVisivelParaAluno(data) {
      return data.mostrarNaLinhaDoTempo == true
        && statusPublicadoOuEmBrevePermitido(data);
    }

    function progressoCamposPermitidos() {
      return [
        "alunoId",
        "googleUid",
        "estudoId",
        "cicloId",
        "status",
        "iniciadoEm",
        "concluidoEm",
        "atualizadoEm",
        "ultimaVisualizacaoEm",
        "percentualLeitura",
        "origem"
      ];
    }

    function perguntaPublicaSemGabarito(data) {
      return !("respostaCorreta" in data)
        && !("alternativaCorretaId" in data)
        && !("alternativasCorretasIds" in data)
        && !("correta" in data)
        && !("isCorrect" in data)
        && !("feedbackCorreto" in data)
        && !("justificativaCorreta" in data)
        && !("respostaEsperadaTexto" in data)
        && !("score" in data)
        && !("nota" in data)
        && !("aprovado" in data)
        && !("certificado" in data)
        && !("emblema" in data)
        && !("badge" in data);
    }
    /*
      Blocos legados explicitados para substituir o fallback global.
      As permissoes abaixo tentam preservar o comportamento atual informado.
      Ajuste fino ainda pode ser necessario quando o export real do Console
      for comparado linha a linha.
    */

    match /estatisticas/graduacoes {
      allow read, write: if true;
    }

    match /estatisticas/visitas {
      allow read, write: if true;
    }

    match /estatisticas/{document} {
      allow read, write: if true;
    }

    match /estatisticas_acessos/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    match /graduacoes/{document} {
      allow read, write: if true;
    }

    match /alunos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || selfUsuarioUpdateSeguro(userId);
    }

    match /usuarios/{userId}/permissoes_usuario/{document=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /alunos/{alunoId}/contadores/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /campeonato_inscricoes/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /inscricoes/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /configuracoes/app {
      allow read: if true;
      allow create, update: if canManageControleAtualizacoes();
      allow delete: if false;
    }

    match /configuracoes/{document} {
      allow read, write: if document != "app";
    }

    match /versoes_app/{versionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageControleAtualizacoes();
    }
    match /mensagens_aniversario/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cache_alunos/{document} {
      allow read, create, update, delete: if isAdmin();
    }

    match /config_graduacoes/{document} {
      allow read, write: if true;
    }

    match /participacoes_eventos_em_andamento/{document} {
      allow read: if true;
      allow update, create: if true;
      allow delete: if isSignedIn();
    }

    match /eventos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /eventos/{eventoId}/participantes_cache/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /turmas/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /turmas/{turmaId}/dashboard_cache/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /turmas/{turmaId}/dashboard_cache_alunos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /turmas/{turmaId}/avaliacoes_alunos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /chamadas/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /chamadas_turma/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /log_presenca_alunos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /locks_chamada/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /contador_presencas_alunos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /configuracoes_sistema/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /configuracoes_sistema/logo_dinamica/temas/{themeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /caca_bug_sessoes/{sessaoId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /caca_bug_sessoes/{sessaoId}/eventos/{eventoId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /academias/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /participacoes_eventos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /inscricoes_aprovadas/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /configuracoes_site/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /site_conteudo/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /timeline_publicacoes/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /config_site_assistente/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /patrocinadores_eventos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /patrocinadores_eventos/{patrocinadorId}/pagamentos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /posts/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /galeria/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /banners/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /uniformes_estoque/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /vendas_uniformes/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /pedidos_uniformes/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /remessas/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /fornecedores/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /pagamentos/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /movimentacoes_estoque/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /estudos_config/global {
      allow read: if isSignedIn();
      allow create, update, delete: if podeGerenciarEstudosFundamentos();
    }

    match /estudos_ciclos/{cicloId} {
      allow read: if podeGerenciarEstudosFundamentos()
        || (isSignedIn() && conteudoVisivelParaAluno(resource.data));
      allow create, update, delete: if podeGerenciarEstudosFundamentos();
    }

    match /estudos/{estudoId} {
      allow read: if podeGerenciarEstudosFundamentos()
        || (isSignedIn() && conteudoVisivelParaAluno(resource.data));
      allow create, update, delete: if podeGerenciarEstudosFundamentos();
    }

    match /estudos_perguntas/{perguntaId} {
      allow read: if podeGerenciarEstudosFundamentos();
      allow create, update: if podeGerenciarEstudosFundamentos()
        && perguntaPublicaSemGabarito(request.resource.data);
      allow delete: if podeGerenciarEstudosFundamentos();
    }
    match /alunos_estudos_progresso/{alunoId}/estudos/{estudoId} {
      allow read: if podeGerenciarEstudosFundamentos() || alunoPertenceAoUsuario(alunoId);
      allow create, update: if alunoPertenceAoUsuario(alunoId)
        && request.resource.data.alunoId == alunoId
        && request.resource.data.googleUid == request.auth.uid
        && request.resource.data.estudoId == estudoId
        && request.resource.data.status in ["iniciado", "concluido"]
        && request.resource.data.percentualLeitura is int
        && request.resource.data.percentualLeitura >= 0
        && request.resource.data.percentualLeitura <= 100
        && request.resource.data.keys().hasOnly(progressoCamposPermitidos());
      allow delete: if false;
    }

    match /estudos_gabaritos/{perguntaId} {
      allow read, create, update, delete: if podeGerenciarEstudosFundamentos();
    }

    match /alunos_estudos_resultados/{alunoId}/estudos/{estudoId} {
      allow read: if podeGerenciarEstudosFundamentos() || alunoPertenceAoUsuario(alunoId);
      allow create, update, delete: if false;
    }

    match /estudos_tentativas/{tentativaId} {
      allow read: if podeGerenciarEstudosFundamentos();
      allow create, update, delete: if false;
    }

    match /avaliacoes_tentativas/{tentativaId} {
      allow read: if podeGerenciarEstudosFundamentos()
        || (
          isSignedIn()
          && resource.data.alunoId is string
          && alunoPertenceAoUsuario(resource.data.alunoId)
        );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

